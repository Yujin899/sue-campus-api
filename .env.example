DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sue_campus?schema=public"

BETTER_AUTH_URL="http://localhost:5000"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

FRONTEND_ORIGIN="http://localhost:3000"

# Set to "none" only when the frontend and API are on different sites (cross-site cookies);
# otherwise keep "lax". Requires HTTPS when "none" (useSecureCookies is already on in production).
COOKIE_SAME_SITE="lax"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Sue Campus"

# Backblaze B2 (S3-compatible) object storage
B2_ENDPOINT=""
B2_REGION=""
B2_BUCKET=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""

# Max lecture upload size in MB
LECTURE_MAX_MB="200"

# Cloudinary (subject thumbnails)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""